                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer",
                                                        "example": 7
                                                    },
                                                    "user_id": {
                                                        "type": "integer",
                                                        "example": 7
                                                    },
                                                    "name": {
                                                        "type": "string",
                                                        "example": "Emily"
                                                    },
                                                    "age": {
                                                        "type": "integer",
                                                        "example": 26
                                                    },
                                                    "pictures": {
                                                        "type": "array",
