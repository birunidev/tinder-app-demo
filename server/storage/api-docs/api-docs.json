        "/people/undo": {
            "post": {
                "tags": [
                    "People"
                ],
                "summary": "Undo last action",
                "description": "Undo the last like or dislike action performed by the authenticated user",
                "operationId": "undoLastAction",
                "responses": {
                    "200": {
                        "description": "Action undone successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Action undone successfully"
                                        },
                                        "data": {
                                            "properties": {
                                                "people_id": {
                                                    "type": "integer",
                                                    "example": 1
                                                },
                                                "action": {
                                                    "type": "string",
                                                    "enum": [
                                                        "like",
                                                        "dislike"
                                                    ],
                                                    "example": "like"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "No action to undo",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
