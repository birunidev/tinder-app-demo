                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/people": {
            "get": {
                "tags": [
                    "People"
                ],
                "summary": "Get recommended people",
                "description": "Returns a paginated list of recommended people for the authenticated user",
                "operationId": "getRecommendedPeople",
                "parameters": [
                    {
                        "name": "page",
