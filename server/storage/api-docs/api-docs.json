                                                                "id": {
                                                                    "type": "integer",
                                                                    "example": 1
                                                                },
                                                                "people_id": {
                                                                    "type": "integer",
                                                                    "example": 7
                                                                },
                                                                "url": {
                                                                    "type": "string",
                                                                    "format": "uri",
                                                                    "example": "https://res.cloudinary.com/dmbeqfkwt/image/upload/v1762866324/tinder-female-2_nbr530.jpg"
                                                                },
                                                                "order": {
                                                                    "type": "integer",
                                                                    "example": 0
                                                                },
                                                                "created_at": {
                                                                    "type": "string",
                                                                    "format": "date-time"
                                                                },
                                                                "updated_at": {
                                                                    "type": "string",
                                                                    "format": "date-time"
                                                                }
                                                            },
                                                            "type": "object"
                                                        }
                                                    },
                                                    "location": {
                                                        "type": "string",
                                                        "example": "Seattle, WA"
                                                    },
                                                    "gender": {
                                                        "type": "string",
                                                        "enum": [
                                                            "M",
                                                            "F"
                                                        ],
                                                        "example": "F"
                                                    },
                                                    "created_at": {
                                                        "type": "string",
                                                        "format": "date-time",
                                                        "example": "2025-11-11T13:17:09.000000Z"
                                                    },
                                                    "updated_at": {
                                                        "type": "string",
                                                        "format": "date-time",
                                                        "example": "2025-11-11T13:17:09.000000Z"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        },
                                        "current_page": {
                                            "type": "integer",
                                            "example": 1
                                        },
                                        "first_page_url": {
                                            "type": "string",
                                            "format": "uri",
                                            "example": "http://127.0.0.1:8000/api/v1/people?page=1"
                                        },
                                        "from": {
                                            "type": "integer",
                                            "example": 1,
                                            "nullable": true
                                        },
                                        "last_page": {
                                            "type": "integer",
                                            "example": 1
                                        },
                                        "last_page_url": {
                                            "type": "string",
                                            "format": "uri",
                                            "example": "http://127.0.0.1:8000/api/v1/people?page=1"
                                        },
                                        "links": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "url": {
                                                        "type": "string",
                                                        "format": "uri",
                                                        "example": null,
                                                        "nullable": true
                                                    },
                                                    "label": {
                                                        "type": "string",
                                                        "example": "&laquo; Previous"
                                                    },
                                                    "active": {
                                                        "type": "boolean",
                                                        "example": false
                                                    },
                                                    "page": {
                                                        "type": "integer",
                                                        "example": null,
                                                        "nullable": true
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        },
                                        "next_page_url": {
                                            "type": "string",
                                            "format": "uri",
                                            "example": null,
                                            "nullable": true
                                        },
                                        "path": {
                                            "type": "string",
                                            "format": "uri",
                                            "example": "http://127.0.0.1:8000/api/v1/people"
                                        },
                                        "per_page": {
                                            "type": "integer",
                                            "example": 15
                                        },
                                        "prev_page_url": {
                                            "type": "string",
                                            "format": "uri",
                                            "example": null,
                                            "nullable": true
                                        },
                                        "to": {
                                            "type": "integer",
                                            "example": 4,
                                            "nullable": true
                                        },
                                        "total": {
                                            "type": "integer",
                                            "example": 4
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
